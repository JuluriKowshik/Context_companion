{
  "manifest_version": 3,
  "name": "Context Companion",
  "version": "0.3.0",
  "description": "A quiet companion for YouTube. Turn it on once; it explains genuinely useful terms as they are spoken, and stays silent otherwise.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Context Companion"
  },
  "background": { "service_worker": "background.js" },
  "commands": {
    "explain-current-subtitle": {
      "suggested_key": { "default": "Alt+X" },
      "description": "Explain the current YouTube subtitle"
    }
  }
}
