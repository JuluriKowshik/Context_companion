# Copy to .env and fill in. Never commit .env.

# gemini | groq | grok | mock
LLM_PROVIDER=groq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# minimal | low | medium | high. Minimal is right for 20-word definitions.
GEMINI_THINKING_LEVEL=minimal

GROQ_API_KEY=
GROQ_MODEL=groq/compound

GROK_API_KEY=
GROK_MODEL=grok-4.1-fast-non-reasoning

LLM_TIMEOUT_SECONDS=6
CONTEXT_WINDOW_SIZE=3

# Persistent cache of concepts learned from the LLM. SQLite, stdlib only.
LEARNED_CACHE_PATH=data/learned_concepts.db
LEXICAL_DICTIONARY_PATH=data/wordnet_dictionary.db
NLTK_DATA_PATH=data/nltk_data

# Automatic display policy (the extension reads these from /config)
PREFETCH_WINDOW_SECONDS=6
AUTO_SHOW_CONFIDENCE=0.85
AUTO_HINT_COOLDOWN_SECONDS=8
MAX_HINTS_PER_MINUTE=4
RECENT_CONCEPT_TTL_SECONDS=1800
LATE_DISPLAY_GRACE_SECONDS=2.5

LOG_LEVEL=INFO
